{
    "name": "laravel-lang/routes",
    "description": "Easy and fast way to localize routes",
    "license": "MIT",
    "keywords": [
        "laravel-lang",
        "i18n",
        "routes",
        "translations",
        "translate",
        "localization"
    ],
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://laravel-lang.com"
        }
    ],
    "support": {
        "source": "https://github.com/Laravel-Lang/mona"
    },
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "illuminate/database": "^12.0 || ^13.0 || dev-master",
        "illuminate/http": "^12.0 || ^13.0 || dev-master",
        "illuminate/support": "^12.0 || ^13.0 || dev-master",
        "laravel-lang/config": "self.version",
        "laravel-lang/exceptions": "self.version",
        "laravel-lang/locale-names": "self.version",
        "laravel-lang/locales": "self.version"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LaravelLang\\Routes\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelLang\\Routes\\LangRoutesServiceProvider"
            ]
        }
    }
}
